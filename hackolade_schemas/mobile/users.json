{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "users",
  "description": "User profiles. Document ID = Firebase Auth UID.",
  "type": "object",
  "properties": {
    "uid":                    { "type": "string",  "description": "Firebase Auth UID — document ID" },
    "firstName":              { "type": "string" },
    "lastName":               { "type": "string" },
    "email":                  { "type": "string" },
    "birthDate":              { "type": "string" },
    "gender":                 { "type": "string" },
    "nationality":            { "type": "string" },
    "homeAddress":            { "type": "string" },
    "profileImage":           { "type": "string" },
    "badges":                 { "type": "array",   "items": { "type": "string" }, "description": "Array of badge IDs" },
    "followingCount":         { "type": "integer" },
    "followersCount":         { "type": "integer" },
    "postsCount":             { "type": "integer" },
    "pendingFollowRequests":  { "type": "array",   "items": { "type": "string" } },
    "sentFollowRequests":     { "type": "array",   "items": { "type": "string" } },
    "emailVerified":          { "type": "boolean" },
    "fcmToken":               { "type": "string",  "description": "Firebase Cloud Messaging token for push notifications" },
    "createdAt":              { "type": "string",  "format": "date-time" },
    "updatedAt":              { "type": "string",  "format": "date-time" }
  }
}
