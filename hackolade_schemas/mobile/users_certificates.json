{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "users / certificates",
  "description": "Subcollection of users. E-certificates earned by the user.",
  "type": "object",
  "properties": {
    "certificateId":    { "type": "string" },
    "userId":           { "type": "string",  "description": "ref → users.uid" },
    "trekkerName":      { "type": "string" },
    "certificateType":  { "type": "string",  "description": "camp3 | fullTrek | peakConqueror" },
    "dateEarned":       { "type": "string",  "format": "date-time" },
    "stationsVisited":  { "type": "array",   "items": { "type": "string" } },
    "totalDistance":    { "type": "number" },
    "totalTimeMinutes": { "type": "integer" },
    "trekStartDate":    { "type": "string",  "format": "date-time" },
    "trekEndDate":      { "type": "string",  "format": "date-time" },
    "isVerified":       { "type": "boolean" },
    "verificationCode": { "type": "string" },
    "createdAt":        { "type": "string",  "format": "date-time" },
    "lastUpdated":      { "type": "string",  "format": "date-time" }
  }
}
