rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Bookings folder: users can upload their own booking attachments
    match /bookings/{bookingId}/attachments/{allFiles=**} {
      // Allow authenticated users to create and write files to bookings
      allow create, write: if request.auth != null;
      
      // Allow any authenticated user to read (they uploaded or own the booking)
      allow read: if request.auth != null;
      
      // Allow the booking owner and admins to delete files
      allow delete: if request.auth != null && 
        (request.auth.uid == firestore.get(/databases/(default)/documents/bookings/{bookingId}).data.userId ||
         request.auth.token.admin == true);
    }

    // Profile images: users can upload and manage their own profile picture
    match /profile-images/{userId}/{allFiles=**} {
      // Allow users to upload their own profile image
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow anyone to read profile images (public)
      allow read: if true;
      
      // Allow users to delete/replace their own profile image
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to update (replace) their own profile image
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Station images: admins only
    match /stations/{stationId}/{allFiles=**} {
      // Only admins can manage station images
      allow create, read, write, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Post images: users can upload images for their own posts
    match /posts/{postId}/{allFiles=**} {
      // Allow authenticated users to upload images
      allow create, write: if request.auth != null;
      
      // Allow anyone to read post images (posts are public)
      allow read: if true;
      
      // Allow users to delete their own post images
      allow delete: if request.auth != null;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}
