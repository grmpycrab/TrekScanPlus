rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: users can read/write their own doc, admins can read all
    match /users/{userId} {
      // Allow ANY authenticated user to read basic user info (for followers/following lists, social features)
      allow read: if request.auth != null;
      
      // Users can only write to their own document
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow ANY authenticated user to update followers/following/postsCount/pendingFollowRequests/sentFollowRequests (for follow/unfollow functionality)
      allow update: if request.auth != null && 
        request.writeFields.hasAny(['followers', 'followersCount', 'following', 'followingCount', 'postsCount', 'pendingFollowRequests', 'sentFollowRequests']);


      // Achievements subcollection: any authenticated user can read (for profile viewing), users can write their own
      match /achievements/{achievementId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null; // Any authenticated user can read achievements (public badges)
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Notifications subcollection: users can read/delete their own, ANY authenticated user can CREATE notifications for them
      match /notifications/{notificationId} {
        allow create: if request.auth != null; // Any authenticated user can create notifications (for other users)
        allow read: if request.auth != null && request.auth.uid == userId; // Users can only read their own
        allow write: if request.auth != null && request.auth.uid == userId; // Users can only update their own
        allow delete: if request.auth != null && request.auth.uid == userId; // Users can only delete their own
      }

      // Bookmarks subcollection: users can read/write their own
      match /bookmarks/{bookmarkId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Visited Stations subcollection: users can read/write their own
      match /visitedStations/{stationId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // E-Certificates subcollection: users can read/write their own
      match /certificates/{certificateId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level bookings collection
    match /bookings/{bookingId} {
      // Create: allow authenticated users to create bookings for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Read (documents): Users can read their own bookings, approved bookings, or admins can read all
      // This rule applies to individual document reads and collection queries
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        resource.data.status == 'approved' ||
        request.auth.token.admin == true
      );

      // Update: owners can update their booking while it's pending or declined (to allow resubmission)
      // Owners can also cancel their own bookings at any time
      // Owners can add attachments to their own bookings at any time
      // Admins can update anytime
      allow update: if request.auth != null && (
        // owner may update attachments at any time (for file uploads)
        (resource.data.userId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachments', 'updatedAt']))
        // owner may update while booking is pending, declined/rejected, or changes required
        || (resource.data.userId == request.auth.uid && 
         (resource.data.status == 'pending' || 
          resource.data.status == 'declined' || 
          resource.data.status == 'rejected' ||
          resource.data.status == 'changes_required' ||
          resource.data.status == 'changes required'))
        // owner may cancel their own booking at any time
        || (resource.data.userId == request.auth.uid && 
            request.resource.data.status == 'cancelled')
        // admin override
        || request.auth.token.admin == true
      );

      // Delete: owners can delete their own bookings, admins can delete any booking
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        request.auth.token.admin == true
      );
    }

    // If you use subcollections, allow collection-group queries for admin:
    match /users/{userId}/bookings/{bookingId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Climb sessions subcollection: users can read/write their own climb sessions
    match /users/{userId}/climbs/{climbId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Social posts collection
    match /posts/{postId} {
      // Anyone authenticated can read public posts
      allow read: if request.auth != null && resource.data.privacy == 'public';

      // Anyone authenticated can read followers-only posts (client-side filtering handles visibility)
      allow read: if request.auth != null && resource.data.privacy == 'followers';

      // Owners can read/write their own posts (including private)
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Anyone authenticated can read posts when querying by userId (for profile viewing)
      // This allows viewing someone's public/followers posts on their profile
      allow read: if request.auth != null;

      // Create: authenticated users can create posts
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Update: owner can update, OR any authenticated user can update comment/like counts
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.writeFields.hasOnly(['likesCount', 'commentsCount', 'sharesCount', 'updatedAt'])
      );

      // Delete: only owner can delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Likes subcollection
      match /likes/{likeId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
        allow delete: if request.auth != null;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
        
        // Allow updating like and reply counts from any authenticated user
        allow update: if request.auth != null && 
          request.writeFields.hasOnly(['likesCount', 'repliesCount']);

        // Likes on comments
        match /likes/{likeId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null;
          allow delete: if request.auth != null;
        }

        // Replies to comments
        match /replies/{replyId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null;
          allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
          
          // Allow updating like counts from any authenticated user
          allow update: if request.auth != null && 
            request.writeFields.hasOnly(['likesCount']);

          // Likes on replies
          match /likes/{likeId} {
            allow read: if request.auth != null;
            allow write: if request.auth != null;
            allow delete: if request.auth != null;
          }
        }
      }
    }

    // System settings collection (calendar configuration)
    match /system_settings/{settingId} {
      // Anyone can read system settings
      allow read: if true;
      
      // Only admins can write system settings
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Calendar configuration collection (date-specific settings)
    match /calendar_config/{dateKey} {
      // Anyone can read calendar configuration (for checking availability)
      allow read: if true;
      
      // Only admins can write calendar configuration
      allow create, update: if request.auth != null && request.auth.token.admin == true;
      
      // Only admins can delete date configurations
      allow delete: if request.auth != null && request.auth.token.admin == true;
      
      // Validate calendar config data structure
      allow create, update: if request.resource.data.keys().hasAll(['date', 'isClosed', 'maxSlots', 'lastUpdated']) &&
        request.resource.data.isClosed is bool &&
        request.resource.data.maxSlots is int &&
        request.resource.data.maxSlots >= 0 &&
        request.resource.data.maxSlots <= 45; // Max 30 normally, can increase up to 45 for special events
    }

    // Top-level notifications collection (for FCM push notifications)
    match /notifications/{notificationId} {
      // Any authenticated user can create notifications (system will use this for push notifications)
      allow create: if request.auth != null;
      
      // No read/write access to top-level notifications (they're managed by backend)
      allow read, write, delete: if false;
    }

    // Email verification codes collection
    match /email_verifications/{userId} {
      // Users can only read/write their own verification data
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Mail collection (for sending emails via Cloud Functions)
    match /mail/{mailId} {
      // Only Cloud Functions can read/write
      allow read, write: if false;
      
      // Allow users to create mail documents (verification codes)
      allow create: if request.auth != null;
    }

    // Station reviews: one document per user per station (doc id = userId)
    match /station_reviews/{stationId}/reviews/{reviewId} {
      // Anyone can read (station detail is useful without signing in)
      allow read: if true;

      allow create: if request.auth != null
        && reviewId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.userDisplayName is string
        && request.resource.data.userDisplayName.size() > 0
        && request.resource.data.userDisplayName.size() <= 120
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;

      allow update: if request.auth != null
        && reviewId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.userDisplayName is string
        && request.resource.data.userDisplayName.size() > 0
        && request.resource.data.userDisplayName.size() <= 120
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

  }
}
