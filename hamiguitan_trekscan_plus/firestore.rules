rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check: server-side custom claim only — no Firestore reads
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Users collection: users can read/write their own doc, admins can read all
    match /users/{userId} {
      // Allow ANY authenticated user to read basic user info (for followers/following lists, social features)
      allow read: if request.auth != null;
      
      // Users can only write to their own document
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Cross-user social-graph updates: ONLY these exact fields may change, preventing
      // role/email injection alongside a legitimate follow payload.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followers', 'followersCount', 'following', 'followingCount',
                    'postsCount', 'pendingFollowRequests', 'sentFollowRequests']);


      // Achievements subcollection: any authenticated user can read (for profile viewing), users can write their own, admins can write any (for badge claim approval)
      match /achievements/{achievementId} {
        allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Notifications subcollection: users can read/delete their own, ANY authenticated user can CREATE notifications for them
      match /notifications/{notificationId} {
        allow create: if request.auth != null; // Any authenticated user can create notifications (for other users)
        allow read: if request.auth != null && request.auth.uid == userId; // Users can only read their own
        // Users can always update their own notifications.
        // Any authenticated user may also update like-aggregation documents
        // (id starts with "like_") because set(merge:true) on a deterministic
        // like_<postId> document is treated as an update when the doc exists.
        allow update: if request.auth != null && (
          request.auth.uid == userId ||
          notificationId.matches('like_.*')
        );
        allow delete: if request.auth != null && request.auth.uid == userId; // Users can only delete their own
      }

      // Bookmarks subcollection: users can read/write their own
      match /bookmarks/{bookmarkId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Visited Stations subcollection: users can read/write their own
      match /visitedStations/{stationId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // E-Certificates subcollection: users can read/write their own
      match /certificates/{certificateId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level bookings collection
    match /bookings/{bookingId} {
      // Create: allow authenticated users to create bookings for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Read (documents): Users can read their own bookings, approved bookings, or admins can read all
      // This rule applies to individual document reads and collection queries
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        resource.data.status == 'approved' ||
        isAdmin()
      );

      // Update: owners can update their booking while it's pending or declined (to allow resubmission)
      // Owners can also cancel their own bookings at any time
      // Owners can add attachments to their own bookings at any time
      // Admins can update anytime
      allow update: if request.auth != null && (
        // owner may update attachments at any time (for file uploads)
        (resource.data.userId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachments', 'updatedAt']))
        // owner may update while booking is pending, declined/rejected, or changes required
        || (resource.data.userId == request.auth.uid && 
         (resource.data.status == 'pending' || 
          resource.data.status == 'declined' || 
          resource.data.status == 'rejected' ||
          resource.data.status == 'changes_required' ||
          resource.data.status == 'changes required'))
        // owner may cancel their own booking at any time
        || (resource.data.userId == request.auth.uid && 
            request.resource.data.status == 'cancelled')
        // admin override
        || isAdmin()
      );

      // Delete: owners can delete their own bookings, admins can delete any booking
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // If you use subcollections, allow collection-group queries for admin:
    match /users/{userId}/bookings/{bookingId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Climb sessions subcollection: users can read/write their own climb sessions
    match /users/{userId}/climbs/{climbId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Social posts collection
    match /posts/{postId} {
      // Admins can read ALL posts regardless of privacy or status (required for Post Moderation).
      allow read: if isAdmin();

      // Anyone authenticated can read public posts
      allow read: if request.auth != null && resource.data.privacy == 'public';

      // Anyone authenticated can read followers-only posts (client-side filtering handles visibility)
      allow read: if request.auth != null && resource.data.privacy == 'followers';

      // Owners can read/write their own posts (including private)
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Create: authenticated users can create posts
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Update: owner or admin can update; anyone may increment aggregation counters only
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likesCount', 'commentsCount', 'sharesCount', 'updatedAt'])
      );

      // Delete: owner or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );

      // Likes subcollection — likeId is the acting user's uid (enforces ownership)
      match /likes/{likeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && likeId == request.auth.uid;
        allow delete: if request.auth != null && likeId == request.auth.uid;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null && (
          resource.data.userId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'repliesCount'])
        );
        allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());

        // Likes on comments — likeId is the acting user's uid
        match /likes/{likeId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && likeId == request.auth.uid;
          allow delete: if request.auth != null && likeId == request.auth.uid;
        }

        // Replies to comments
        match /replies/{replyId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
          allow update: if request.auth != null && (
            resource.data.userId == request.auth.uid ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
          );
          allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());

          // Likes on replies — likeId is the acting user's uid
          match /likes/{likeId} {
            allow read: if request.auth != null;
            allow create: if request.auth != null && likeId == request.auth.uid;
            allow delete: if request.auth != null && likeId == request.auth.uid;
          }
        }
      }
    }

    // System settings collection (calendar configuration)
    match /system_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Calendar configuration collection (date-specific settings)
    match /calendar_config/{dateKey} {
      allow read: if request.auth != null;
      
      // Only admins can write calendar configuration
      allow create, update: if request.auth != null && isAdmin();
      
      // Only admins can delete date configurations
      allow delete: if request.auth != null && isAdmin();
      
      // Validate calendar config data structure
      allow create, update: if request.resource.data.keys().hasAll(['date', 'isClosed', 'maxSlots', 'lastUpdated']) &&
        request.resource.data.isClosed is bool &&
        request.resource.data.maxSlots is int &&
        request.resource.data.maxSlots >= 0 &&
        request.resource.data.maxSlots <= 45; // Max 30 normally, can increase up to 45 for special events
    }

    // Top-level notifications collection — Cloud Functions use Admin SDK (bypasses rules).
    // No client-side access required.
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    // Email verification codes collection
    match /email_verifications/{userId} {
      // Users can only read/write their own verification data
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Mail collection (for sending emails via Cloud Functions)
    match /mail/{mailId} {
      // Only Cloud Functions can read/write
      allow read, write: if false;
      
      // Allow users to create mail documents (verification codes)
      allow create: if request.auth != null;
    }

    // Collection-group rule: lets a user read their own join requests across ALL
    // groups in a collectionGroup('joinRequests') query.  Without this wildcard
    // path, Firestore rejects collection-group queries even when the per-document
    // rule would allow them, because the SDK can't resolve the groupId at query
    // planning time.
    match /{path=**}/joinRequests/{requestId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Group bookings collection
    match /groupBookings/{groupId} {
      // Any authenticated user may read group bookings.
      // This covers: individual document reads, the Discover feed query
      // (filtered by status == 'open'), and the calendar/availability queries
      // that range-filter by trekDate across all active statuses.
      // Sensitive member data lives in the joinRequests subcollection, which
      // has its own access controls below.
      allow read: if request.auth != null;

      // Authenticated users can create a group booking as the organizer
      allow create: if request.auth != null &&
        request.resource.data.organizerId == request.auth.uid;

      // Organizer can update their own group; admins can update any
      allow update: if request.auth != null && (
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );

      // Only admins can delete group bookings
      allow delete: if request.auth != null && isAdmin();

      // Join requests subcollection
      match /joinRequests/{requestId} {
        // Group organizer and admins can read all join requests for a group
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/groupBookings/$(groupId)).data.organizerId == request.auth.uid ||
          isAdmin() ||
          resource.data.userId == request.auth.uid
        );

        // Authenticated users can submit a join request for themselves
        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid;

        // Organizer can approve/decline; user can cancel their own; admins can do anything
        allow update: if request.auth != null && (
          get(/databases/$(database)/documents/groupBookings/$(groupId)).data.organizerId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

        allow delete: if request.auth != null && (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Pricing configuration (read by mobile app, written by admins only)
    match /pricingConfig/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Versioned pricing history (read by mobile app, written by admins only)
    match /pricingVersions/{versionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Climb sessions (trekker check-in/out activity)
    match /climb_sessions/{sessionId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // Badge claims — submitted by users, reviewed by admins
    match /badge_claims/{claimId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // Badge definitions — custom event/admin-created badges
    match /badge_definitions/{badgeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Station reviews: top-level list + per-review subcollection
    match /station_reviews/{stationId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Wildcard path rule required for collectionGroup('reviews') queries.
    // Without this, Firestore rejects collectionGroup reads even though the
    // per-document rule below would allow them — the SDK cannot resolve the
    // full path at query-planning time without a wildcard anchor.
    // Used by the admin Station Activity panel to aggregate all station reviews.
    match /{path=**}/reviews/{reviewId} {
      allow read: if request.auth != null;
    }

    match /station_reviews/{stationId}/reviews/{reviewId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && reviewId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.userDisplayName is string
        && request.resource.data.userDisplayName.size() > 0
        && request.resource.data.userDisplayName.size() <= 120
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;

      allow update: if request.auth != null
        && reviewId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.userDisplayName is string
        && request.resource.data.userDisplayName.size() > 0
        && request.resource.data.userDisplayName.size() <= 120
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

  }
}
